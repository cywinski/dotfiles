{
  "name": "claude-skill-excalidraw",
  "private": true,
  "type": "module",
  "description": "Build-time bundle + runtime driver for the excalidraw skill.",
  "dependencies": {
    "playwright-core": "^1.56.0"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "2.2.2",
    "esbuild": "^0.25.0"
  },
  "scripts": {
    "build": "esbuild scripts/browser-entry.js --bundle --format=iife --outfile=scripts/bundle.js --define:process.env.NODE_ENV=\"\\\"production\\\"\" --loader:.woff2=dataurl --loader:.ttf=dataurl --loader:.otf=dataurl"
  }
}
